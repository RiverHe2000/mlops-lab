{
  "uid": "mlwatch-monitoring",
  "title": "mlwatch · model monitoring",
  "tags": ["mlwatch", "model-monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Window status",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_window_status", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [
        {"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "WARN", "color": "orange"}, "2": {"text": "CRITICAL", "color": "red"}}}
      ], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Recommended action",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_window_action", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [
        {"type": "value", "options": {"0": {"text": "none", "color": "green"}, "2": {"text": "investigate", "color": "orange"}, "3": {"text": "RETRAIN", "color": "red"}}}
      ], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 2}, {"color": "red", "value": 3}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "Realised AUC",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_auc", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 3, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.7}, {"color": "green", "value": 0.75}]}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "Label coverage",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_label_coverage", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0}},
      "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "bargauge", "title": "Feature PSI (last window)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_feature_psi", "legendFormat": "{{feature}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 0.5, "decimals": 3, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.10}, {"color": "red", "value": 0.25}]}}},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Score PSI and decline rate",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "mlwatch_score_psi", "legendFormat": "score PSI", "refId": "A"},
        {"expr": "mlwatch_decline_rate", "legendFormat": "decline rate", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": [
        {"matcher": {"id": "byName", "options": "decline rate"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "custom.axisPlacement", "value": "right"}]}
      ]}
    },
    {
      "id": 7, "type": "timeseries", "title": "Feature PSI over time",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_feature_psi", "legendFormat": "{{feature}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 1, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.10}, {"color": "red", "value": 0.25}]}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Missing rate per feature",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mlwatch_feature_missing_rate", "legendFormat": "{{feature}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "lineWidth": 1}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Rows and labels per window",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "mlwatch_window_rows", "legendFormat": "rows", "refId": "A"},
        {"expr": "mlwatch_window_labels", "legendFormat": "labels", "refId": "B"}
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Monitoring runs by status",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(mlwatch_runs_total[1d])", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60}}}
    }
  ]
}
